#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
HFish 威胁情报自动化生成脚本
功能：从 HFish API 拉取攻击日志，清洗聚合后生成静态 HTML 页面
适配 HFish v2.7.0
"""

import requests
import pandas as pd
from datetime import datetime, timedelta
from jinja2 import Template
import os
import urllib3

# 禁用 SSL 警告
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# ==================== 配置区域 ====================
HFISH_BASE_URL = "https://127.0.0.1:4433"
API_KEY = "SiFtBHLWzBmcRjndOoQEwPAjvBSBefxSDfvxMoxXwjetfnELGjXIbTZvhFZceacI"

# 查询时间范围（最近7天，用时间戳）
END_TIME = datetime.now()
START_TIME = END_TIME - timedelta(days=90)

# 输出目录
OUTPUT_DIR = "./docs"
OUTPUT_FILE = "index.html"

# ==================== 1. 调用 HFish API ====================
def fetch_attack_logs():
    """
    从 HFish API 获取攻击日志
    """
    url = f"{HFISH_BASE_URL}/api/v1/attack/detail"
    
    headers = {
        "Content-Type": "application/json"
    }
    
    params = {
        "api_key": API_KEY
    }
    
    # 转换为时间戳
    start_timestamp = int(START_TIME.timestamp())
    end_timestamp = int(END_TIME.timestamp())
    
    payload = {
        "start_time": start_timestamp,
        "end_time": end_timestamp,
        "page": 1,
        "page_size": 5000
    }
    
    try:
        response = requests.post(url, headers=headers, params=params, json=payload, verify=False, timeout=30)
        response.raise_for_status()
        data = response.json()
        
        if data.get("response_code") == 0:
            return data.get("data", [])
        else:
            print(f"API 返回错误: {data.get('verbose_msg')}")
            return []
            
    except requests.exceptions.RequestException as e:
        print(f"请求失败: {e}")
        return []

# ==================== 2. 数据清洗与聚合 ====================
def process_data(raw_logs):
    """
    对原始日志进行清洗、去重、聚合分析
    """
    if not raw_logs:
        return pd.DataFrame(), {}
    
    df = pd.DataFrame(raw_logs)
    
    # 根据实际返回的字段进行映射
    column_mapping = {
        "attack_ip": "攻击源IP",
        "ip_location": "地理位置",
        "client_name": "蜜罐节点",
        "service_name": "服务类型",
        "service_port": "端口",
        "attack_info": "攻击信息",
        "create_time": "攻击时间"
    }
    
    # 只保留存在的列
    available_columns = [col for col in column_mapping.keys() if col in df.columns]
    df = df[available_columns].copy()
    
    # 重命名列
    df.rename(columns={k: v for k, v in column_mapping.items() if k in df.columns}, inplace=True)
    
    # 时间戳转换为可读格式
    if "攻击时间" in df.columns:
        df["攻击时间"] = pd.to_datetime(df["攻击时间"], unit='s').dt.strftime("%Y-%m-%d %H:%M")
    
    # 从地理位置中提取国家
    if "地理位置" in df.columns:
        df["国家"] = df["地理位置"].apply(lambda x: x.split("-")[0] if isinstance(x, str) and "-" in x else x)
    
    # 数据聚合统计
    stats = {
        "total_attacks": len(df),
        "unique_ips": df["攻击源IP"].nunique() if "攻击源IP" in df.columns else 0,
        "top_ips": df["攻击源IP"].value_counts().head(10).to_dict() if "攻击源IP" in df.columns else {},
        "top_services": df["服务类型"].value_counts().head(10).to_dict() if "服务类型" in df.columns else {},
        "top_countries": df["国家"].value_counts().head(10).to_dict() if "国家" in df.columns else {},
        "time_range": f"{START_TIME.strftime('%Y-%m-%d %H:%M')} ~ {END_TIME.strftime('%Y-%m-%d %H:%M')}"
    }
    
    return df, stats

# ==================== 3. HTML 模板 ====================
HTML_TEMPLATE = """
